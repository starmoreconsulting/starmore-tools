PUBLIC_SHOW_HIDDEN=false
# Keep ads disabled until your AdSense account, consent messages, privacy notice, and ad unit are ready.
PUBLIC_ADSENSE_READY=false
# Use the publisher ID and responsive display ad unit ID from your AdSense account.
PUBLIC_ADSENSE_CLIENT_ID=
PUBLIC_ADSENSE_SLOT_ID=
# Set true only after publishing the Google-certified CMP/privacy messages in AdSense.
PUBLIC_ADSENSE_CMP_CONFIGURED=false
# Cloudflare Web Analytics is opt-in. Use its manual snippet/token and do not also enable Pages auto-injection.
PUBLIC_CF_ANALYTICS_ENABLED=false
PUBLIC_CF_ANALYTICS_TOKEN=
