---
import ToolLayout from '../components/ToolLayout.astro';
import LogoStudioApp from '../engines/logo-studio/panels/LogoStudioApp';
import { tools } from '../data/tools';

const tool = tools.find((entry) => entry.slug === 'logo-studio');
if (!tool) throw new Error('Logo Studio is missing from the tool registry.');
---

<ToolLayout
	title={tool.seoTitle}
	description={tool.seoDescription}
>
	<section class="tool-page logo-phase-page">
		<a class="back-link" href="/#tool-library">← All tools</a>
		<header class="tool-page-header">
			<p class="eyebrow">LOGO DESIGN</p>
			<h1>{tool.name}</h1>
			<p>{tool.description} Nothing leaves your device.</p>
		</header>
		<LogoStudioApp client:only="react" />
		<section class="tool-guide" aria-labelledby="how-to-use">
			<h2 id="how-to-use">How to use {tool.name}</h2>
			<ol>{tool.howTo.map((step) => <li>{step}</li>)}</ol>
			<div class="tool-faqs">
				{tool.faqs.map((faq) => (
					<article class="tool-faq">
						<h3>{faq.question}</h3>
						<p>{faq.answer}</p>
					</article>
				))}
			</div>
		</section>
	</section>
</ToolLayout>
