---
import ToolLayout from '../components/ToolLayout.astro';
import SpecialCharactersNote from '../components/brand-studio/SpecialCharactersNote.astro';
import Recommended from '../components/Recommended.astro';
import AgeCalculator from '../components/tools/AgeCalculator';
import BasicCalculator from '../components/tools/BasicCalculator';
import TipCalculator from '../components/tools/TipCalculator';
import UnitPriceCalculator from '../components/tools/UnitPriceCalculator';
import StatisticsCalculator from '../components/tools/StatisticsCalculator';
import FractionCalculator from '../components/tools/FractionCalculator';
import CaseConverter from '../components/tools/CaseConverter';
import CharacterCounter from '../components/tools/CharacterCounter';
import CompoundInterestCalculator from '../components/tools/CompoundInterestCalculator';
import DateDifferenceCalculator from '../components/tools/DateDifferenceCalculator';
import DiscountCalculator from '../components/tools/DiscountCalculator';
import JsonFormatter from '../components/tools/JsonFormatter';
import PercentageCalculator from '../components/tools/PercentageCalculator';
import QrCodeGenerator from '../components/tools/QrCodeGenerator';
import PasswordGenerator from '../components/tools/PasswordGenerator';
import ImageCompressor from '../components/tools/ImageCompressor';
import ImageResizer from '../components/tools/ImageResizer';
import RoiCalculator from '../components/tools/RoiCalculator';
import BmiCalculator from '../components/tools/BmiCalculator';
import SimpleInterestCalculator from '../components/tools/SimpleInterestCalculator';
import DateAddSubtractCalculator from '../components/tools/DateAddSubtractCalculator';
import TimeZoneConverter from '../components/tools/TimeZoneConverter';
import ReadingTimeCalculator from '../components/tools/ReadingTimeCalculator';
import SentenceParagraphCounter from '../components/tools/SentenceParagraphCounter';
import SortTextAlphabetically from '../components/tools/SortTextAlphabetically';
import FindReplaceText from '../components/tools/FindReplaceText';
import TextToSlugConverter from '../components/tools/TextToSlugConverter';
import ImageToPdfConverter from '../components/tools/ImageToPdfConverter';
import PdfMerger from '../components/tools/PdfMerger';
import PdfSplitter from '../components/tools/PdfSplitter';
import PdfPageRotator from '../components/tools/PdfPageRotator';
import ImageFormatConverter from '../components/tools/ImageFormatConverter';
import ImageCropper from '../components/tools/ImageCropper';
import ImageUpscaler from '../components/tools/ImageUpscaler';
import ImageSharpener from '../components/tools/ImageSharpener';
import ImageDenoiser from '../components/tools/ImageDenoiser';
import PhotoAdjustments from '../components/tools/PhotoAdjustments';
import ImageColourPicker from '../components/tools/ImageColourPicker';
import ColourPaletteExtractor from '../components/tools/ColourPaletteExtractor';
import FaviconGenerator from '../components/tools/FaviconGenerator';
import SocialMediaImageResizer from '../components/tools/SocialMediaImageResizer';
import ImageWatermarkGenerator from '../components/tools/ImageWatermarkGenerator';
import BackgroundRemover from '../components/tools/BackgroundRemover';
import BackgroundChanger from '../components/tools/BackgroundChanger';
import LogoBackgroundRemover, { LogoTransparencyEditor } from '../components/tools/LogoBackgroundRemover';
import PassportPhotoMaker from '../components/tools/PassportPhotoMaker';
import ProfilePictureMaker from '../components/tools/ProfilePictureMaker';
import PhotoCollageMaker from '../components/tools/PhotoCollageMaker';
import MemeGenerator from '../components/tools/MemeGenerator';
import ScreenshotBeautifier from '../components/tools/ScreenshotBeautifier';
import OldPhotoRestoration from '../components/tools/OldPhotoRestoration';
import WatermarkRemover from '../components/tools/WatermarkRemover';
import MarkdownEditor from '../components/tools/MarkdownEditor';
import ProfitMarginCalculator from '../components/tools/ProfitMarginCalculator';
import ProfitLossCalculator from '../components/tools/ProfitLossCalculator';
import BreakEvenCalculator from '../components/tools/BreakEvenCalculator';
import CurrencyConverter from '../components/tools/CurrencyConverter';
import ElectricityConsumptionCalculator from '../components/tools/ElectricityConsumptionCalculator';
import FuelConsumptionCalculator from '../components/tools/FuelConsumptionCalculator';
import LoanRepaymentCalculator from '../components/tools/LoanRepaymentCalculator';
import RemoveDuplicateLines from '../components/tools/RemoveDuplicateLines';
import RemoveExtraSpaces from '../components/tools/RemoveExtraSpaces';
import LoremIpsumGenerator from '../components/tools/LoremIpsumGenerator';
import TextComparisonTool from '../components/tools/TextComparisonTool';
import ReverseTextGenerator from '../components/tools/ReverseTextGenerator';
import TextFormatter from '../components/tools/TextFormatter';
import Notepad from '../components/tools/Notepad';
import UnitConverter from '../components/tools/UnitConverter';
import VatCalculator from '../components/tools/VatCalculator';
import WordCounter from '../components/tools/WordCounter';
import TextLogoGenerator from '../components/tools/TextLogoGenerator';
import MonogramLogoGenerator from '../components/tools/MonogramLogoGenerator';
import LogoStudioApp from '../engines/logo-studio/panels/LogoStudioApp';
import BrandNameGenerator from '../engines/brand-studio/panels/BrandNameGenerator';
import BrandSloganGenerator from '../engines/brand-studio/panels/BrandSloganGenerator';
import BrandStrategyGenerator from '../engines/brand-studio/panels/BrandStrategyGenerator';
import BrandColourPaletteGenerator from '../engines/brand-studio/panels/BrandColourPaletteGenerator';
import BrandTypographyTool from '../engines/brand-studio/panels/BrandTypographyTool';
import BrandFontLoadCheck from '../engines/brand-studio/panels/BrandFontLoadCheck';
import { departments, publishedTools } from '../data/tools';

export function getStaticPaths() {
	return publishedTools.filter((tool) => tool.slug !== 'logo-studio').map((tool) => ({
		params: { slug: tool.slug },
		props: { tool },
	}));
}

const { tool } = Astro.props;
const departmentName = departments.find((department) => department.slug === tool.department)?.name;
---

<ToolLayout title={tool.seoTitle} description={tool.seoDescription}>
	<section class="tool-page">
		<a class="back-link" href="/#tool-library">← All tools</a>
		<header class="tool-page-header">
			<p class="eyebrow">{departmentName?.toUpperCase()} TOOL</p>
			<h1>{tool.name}</h1>
			<p>{tool.description}</p>
		</header>
		<div class="tool-workspace">
			{tool.component === 'FractionCalculator' && <FractionCalculator client:load />}
			{tool.component === 'BasicCalculator' && <BasicCalculator client:load />}
			{tool.component === 'TipCalculator' && <TipCalculator client:load />}
			{tool.component === 'UnitPriceCalculator' && <UnitPriceCalculator client:load />}
			{tool.component === 'StatisticsCalculator' && <StatisticsCalculator client:load />}
			{tool.component === 'CaseConverter' && <CaseConverter client:load />}
			{tool.component === 'WordCounter' && <WordCounter client:load />}
			{tool.component === 'JsonFormatter' && <JsonFormatter client:load />}
			{tool.component === 'PercentageCalculator' && <PercentageCalculator client:load />}
			{tool.component === 'DiscountCalculator' && <DiscountCalculator client:load />}
			{tool.component === 'VatCalculator' && <VatCalculator client:load />}
			{tool.component === 'ProfitMarginCalculator' && <ProfitMarginCalculator client:load />}
			{tool.component === 'ProfitLossCalculator' && <ProfitLossCalculator client:load />}
			{tool.component === 'BreakEvenCalculator' && <BreakEvenCalculator client:load />}
			{tool.component === 'CurrencyConverter' && <CurrencyConverter client:load />}
			{tool.component === 'ElectricityConsumptionCalculator' && <ElectricityConsumptionCalculator client:load />}
			{tool.component === 'FuelConsumptionCalculator' && <FuelConsumptionCalculator client:load />}
			{tool.component === 'LoanRepaymentCalculator' && <LoanRepaymentCalculator client:load />}
			{tool.component === 'AgeCalculator' && <AgeCalculator client:load />}
			{tool.component === 'CharacterCounter' && <CharacterCounter client:load />}
			{tool.component === 'DateDifferenceCalculator' && <DateDifferenceCalculator client:load />}
			{tool.component === 'CompoundInterestCalculator' && <CompoundInterestCalculator client:load />}
			{tool.component === 'UnitConverter' && <UnitConverter client:load />}
			{tool.component === 'RemoveDuplicateLines' && <RemoveDuplicateLines client:load />}
			{tool.component === 'RemoveExtraSpaces' && <RemoveExtraSpaces client:load />}
			{tool.component === 'LoremIpsumGenerator' && <LoremIpsumGenerator client:load />}
			{tool.component === 'TextComparisonTool' && <TextComparisonTool client:load />}
			{tool.component === 'ReverseTextGenerator' && <ReverseTextGenerator client:load />}
			{tool.component === 'TextFormatter' && <TextFormatter client:load />}
			{tool.component === 'Notepad' && <Notepad client:load />}
			{tool.component === 'QrCodeGenerator' && <QrCodeGenerator client:load />}
			{tool.component === 'PasswordGenerator' && <PasswordGenerator client:load />}
			{tool.component === 'ImageCompressor' && <ImageCompressor client:load />}
			{tool.component === 'ImageResizer' && <ImageResizer client:load />}
			{tool.component === 'RoiCalculator' && <RoiCalculator client:load />}
			{tool.component === 'BmiCalculator' && <BmiCalculator client:load />}
			{tool.component === 'SimpleInterestCalculator' && <SimpleInterestCalculator client:load />}
			{tool.component === 'DateAddSubtractCalculator' && <DateAddSubtractCalculator client:load />}
			{tool.component === 'TimeZoneConverter' && <TimeZoneConverter client:load />}
			{tool.component === 'ReadingTimeCalculator' && <ReadingTimeCalculator client:load />}
			{tool.component === 'SentenceParagraphCounter' && <SentenceParagraphCounter client:load />}
			{tool.component === 'SortTextAlphabetically' && <SortTextAlphabetically client:load />}
			{tool.component === 'FindReplaceText' && <FindReplaceText client:load />}
			{tool.component === 'TextToSlugConverter' && <TextToSlugConverter client:load />}
			{tool.component === 'ImageToPdfConverter' && <ImageToPdfConverter client:load />}
			{tool.component === 'PdfMerger' && <PdfMerger client:load />}
			{tool.component === 'PdfSplitter' && <PdfSplitter client:load />}
			{tool.component === 'PdfPageRotator' && <PdfPageRotator client:load />}
			{tool.component === 'ImageFormatConverter' && <ImageFormatConverter client:load />}
			{tool.component === 'ImageCropper' && <ImageCropper client:load />}
			{tool.component === 'ImageUpscaler' && <ImageUpscaler client:load />}
			{tool.component === 'ImageSharpener' && <ImageSharpener client:load preset={tool.imagePreset} />}
			{tool.component === 'ImageDenoiser' && <ImageDenoiser client:load />}
			{tool.component === 'PhotoAdjustments' && <PhotoAdjustments client:load preset={tool.imagePreset} />}
			{tool.component === 'ImageColourPicker' && <ImageColourPicker client:load />}
			{tool.component === 'ColourPaletteExtractor' && <ColourPaletteExtractor client:load />}
			{tool.component === 'FaviconGenerator' && <FaviconGenerator client:load />}
			{tool.component === 'SocialMediaImageResizer' && <SocialMediaImageResizer client:load />}
			{tool.component === 'ImageWatermarkGenerator' && <ImageWatermarkGenerator client:load />}
			{tool.component === 'BackgroundRemover' && <BackgroundRemover client:load />}
			{tool.component === 'BackgroundChanger' && <BackgroundChanger client:load />}
			{tool.component === 'LogoBackgroundRemover' && <LogoBackgroundRemover client:load />}
			{tool.component === 'LogoTransparencyEditor' && <LogoTransparencyEditor client:load />}
			{tool.component === 'PassportPhotoMaker' && <PassportPhotoMaker client:load />}
			{tool.component === 'ProfilePictureMaker' && <ProfilePictureMaker client:load />}
			{tool.component === 'PhotoCollageMaker' && <PhotoCollageMaker client:load />}
			{tool.component === 'MemeGenerator' && <MemeGenerator client:load />}
			{tool.component === 'ScreenshotBeautifier' && <ScreenshotBeautifier client:load />}
			{tool.component === 'OldPhotoRestoration' && <OldPhotoRestoration client:load />}
			{tool.component === 'WatermarkRemover' && <WatermarkRemover client:load />}
			{tool.component === 'MarkdownEditor' && <MarkdownEditor client:load />}
			{tool.component === 'TextLogoGenerator' && <TextLogoGenerator client:load />}
			{tool.component === 'MonogramLogoGenerator' && <MonogramLogoGenerator client:load />}
			{tool.component === 'LogoStudioApp' && <LogoStudioApp client:only="react" preset={tool.preset} designPreset={tool.designPreset} />}
			{tool.component === 'BrandNameGenerator' && <BrandNameGenerator client:load />}
			{tool.component === 'BrandSloganGenerator' && <BrandSloganGenerator client:load />}
			{tool.component === 'BrandStrategyGenerator' && <BrandStrategyGenerator client:load kind={tool.strategyKind ?? 'mission-vision'} />}
			{tool.component === 'BrandColourPaletteGenerator' && <BrandColourPaletteGenerator client:load />}
			{tool.component === 'BrandTypographyTool' && <BrandTypographyTool client:load />}
			{tool.component === 'BrandFontLoadCheck' && <BrandFontLoadCheck client:load />}
		</div>
		<section class="tool-guide" aria-labelledby="how-to-use">
			{tool.limitations && <p class="inline-note">{tool.limitations}</p>}
			{tool.privacyNote && <p class="privacy-note">{tool.privacyNote}</p>}
			{['business-card-designer', 'letterhead-designer', 'envelope-designer'].includes(tool.slug) && <SpecialCharactersNote />}
			<h2 id="how-to-use">How to use {tool.name}</h2>
			{tool.guideCopy && <p class="tool-guide-copy">{tool.guideCopy}</p>}
			<ol>
				{tool.howTo.map((step) => <li>{step}</li>)}
			</ol>
			<div class="tool-faqs">
				{tool.faqs.map((faq) => (
					<article class="tool-faq">
						<h3>{faq.question}</h3>
						<p>{faq.answer}</p>
					</article>
				))}
			</div>
		</section>
		{tool.recommended && <Recommended {...tool.recommended} />}
	</section>
</ToolLayout>
