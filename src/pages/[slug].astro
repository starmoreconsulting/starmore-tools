			<p class="eyebrow">{departmentName?.toUpperCase()} TOOL</p>
			<h1>{tool.name}</h1>
			<p>{tool.description}</p>
		</header>}
		<div class="tool-workspace">
			{tool.component === 'FractionCalculator' && <FractionCalculator client:load />}
