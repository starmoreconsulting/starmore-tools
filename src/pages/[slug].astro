export function getStaticPaths() {
	return publishedTools.filter((tool) => tool.slug !== 'logo-studio').map((tool) => ({
		params: { slug: tool.slug },
		props: { tool },
	}));
}

const { tool } = Astro.props;
const departmentName = departments.find((department) => department.slug === tool.department)?.name;
const isVisualEditor = tool.component === 'LogoStudioApp';
---

