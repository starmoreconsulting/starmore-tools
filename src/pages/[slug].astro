---
import ToolLayout from '../components/ToolLayout.astro';
import Recommended from '../components/Recommended.astro';
import AgeCalculator from '../components/tools/AgeCalculator';
import CaseConverter from '../components/tools/CaseConverter';
import CharacterCounter from '../components/tools/CharacterCounter';
import CompoundInterestCalculator from '../components/tools/CompoundInterestCalculator';
import DateDifferenceCalculator from '../components/tools/DateDifferenceCalculator';
import DiscountCalculator from '../components/tools/DiscountCalculator';
import JsonFormatter from '../components/tools/JsonFormatter';
import PercentageCalculator from '../components/tools/PercentageCalculator';
import QrCodeGenerator from '../components/tools/QrCodeGenerator';
import PasswordGenerator from '../components/tools/PasswordGenerator';
import ImageCompressor from '../components/tools/ImageCompressor';
import ImageResizer from '../components/tools/ImageResizer';
import RoiCalculator from '../components/tools/RoiCalculator';
import BmiCalculator from '../components/tools/BmiCalculator';
import SimpleInterestCalculator from '../components/tools/SimpleInterestCalculator';
import DateAddSubtractCalculator from '../components/tools/DateAddSubtractCalculator';
import TimeZoneConverter from '../components/tools/TimeZoneConverter';
import ReadingTimeCalculator from '../components/tools/ReadingTimeCalculator';
import SentenceParagraphCounter from '../components/tools/SentenceParagraphCounter';
import SortTextAlphabetically from '../components/tools/SortTextAlphabetically';
import FindReplaceText from '../components/tools/FindReplaceText';
import TextToSlugConverter from '../components/tools/TextToSlugConverter';
import ImageToPdfConverter from '../components/tools/ImageToPdfConverter';
import PdfMerger from '../components/tools/PdfMerger';
import PdfSplitter from '../components/tools/PdfSplitter';
import PdfPageRotator from '../components/tools/PdfPageRotator';
import ImageFormatConverter from '../components/tools/ImageFormatConverter';
import ImageCropper from '../components/tools/ImageCropper';
import ImageUpscaler from '../components/tools/ImageUpscaler';
import MarkdownEditor from '../components/tools/MarkdownEditor';
import ProfitMarginCalculator from '../components/tools/ProfitMarginCalculator';
import LoanRepaymentCalculator from '../components/tools/LoanRepaymentCalculator';
import RemoveDuplicateLines from '../components/tools/RemoveDuplicateLines';
import UnitConverter from '../components/tools/UnitConverter';
import VatCalculator from '../components/tools/VatCalculator';
import WordCounter from '../components/tools/WordCounter';
import TextLogoGenerator from '../components/tools/TextLogoGenerator';
import MonogramLogoGenerator from '../components/tools/MonogramLogoGenerator';
import LogoStudioApp from '../engines/logo-studio/panels/LogoStudioApp';
import { departments, tools } from '../data/tools';

export function getStaticPaths() {
	const hiddenGeneratorSlugs = new Set([
		'template-logo-generator',
		'business-name-logo-generator',
		'industry-logo-generator',
		'icon-logo-generator',
		'initials-logo-generator',
		'logo-variation-generator',
		'black-and-white-logo-generator',
		'logo-colour-variation-generator',
		'reference-logo-generator',
		'logo-redesign-tool',
		'logo-mockup-generator',
		'business-card-mockup',
		'tshirt-logo-mockup',
		'logo-preview-tool',
		'logo-export-centre',
		'image-upscaler',
	]);
	return tools.filter((tool) => (tool.live || hiddenGeneratorSlugs.has(tool.slug)) && tool.slug !== 'logo-studio').map((tool) => ({
		params: { slug: tool.slug },
		props: { tool },
	}));
}

const { tool } = Astro.props;
const departmentName = departments.find((department) => department.slug === tool.department)?.name;
---

<ToolLayout title={tool.seoTitle} description={tool.seoDescription}>
	<section class="tool-page">
		<a class="back-link" href="/#tool-library">← All tools</a>
		<header class="tool-page-header">
			<p class="eyebrow">{departmentName?.toUpperCase()} TOOL</p>
			<h1>{tool.name}</h1>
			<p>{tool.description}</p>
		</header>
		<div class="tool-workspace">
			{tool.component === 'CaseConverter' && <CaseConverter client:load />}
			{tool.component === 'WordCounter' && <WordCounter client:load />}
			{tool.component === 'JsonFormatter' && <JsonFormatter client:load />}
			{tool.component === 'PercentageCalculator' && <PercentageCalculator client:load />}
			{tool.component === 'DiscountCalculator' && <DiscountCalculator client:load />}
			{tool.component === 'VatCalculator' && <VatCalculator client:load />}
			{tool.component === 'ProfitMarginCalculator' && <ProfitMarginCalculator client:load />}
			{tool.component === 'LoanRepaymentCalculator' && <LoanRepaymentCalculator client:load />}
			{tool.component === 'AgeCalculator' && <AgeCalculator client:load />}
			{tool.component === 'CharacterCounter' && <CharacterCounter client:load />}
			{tool.component === 'DateDifferenceCalculator' && <DateDifferenceCalculator client:load />}
			{tool.component === 'CompoundInterestCalculator' && <CompoundInterestCalculator client:load />}
			{tool.component === 'UnitConverter' && <UnitConverter client:load />}
			{tool.component === 'RemoveDuplicateLines' && <RemoveDuplicateLines client:load />}
			{tool.component === 'QrCodeGenerator' && <QrCodeGenerator client:load />}
			{tool.component === 'PasswordGenerator' && <PasswordGenerator client:load />}
			{tool.component === 'ImageCompressor' && <ImageCompressor client:load />}
			{tool.component === 'ImageResizer' && <ImageResizer client:load />}
			{tool.component === 'RoiCalculator' && <RoiCalculator client:load />}
			{tool.component === 'BmiCalculator' && <BmiCalculator client:load />}
			{tool.component === 'SimpleInterestCalculator' && <SimpleInterestCalculator client:load />}
			{tool.component === 'DateAddSubtractCalculator' && <DateAddSubtractCalculator client:load />}
			{tool.component === 'TimeZoneConverter' && <TimeZoneConverter client:load />}
			{tool.component === 'ReadingTimeCalculator' && <ReadingTimeCalculator client:load />}
			{tool.component === 'SentenceParagraphCounter' && <SentenceParagraphCounter client:load />}
			{tool.component === 'SortTextAlphabetically' && <SortTextAlphabetically client:load />}
			{tool.component === 'FindReplaceText' && <FindReplaceText client:load />}
			{tool.component === 'TextToSlugConverter' && <TextToSlugConverter client:load />}
			{tool.component === 'ImageToPdfConverter' && <ImageToPdfConverter client:load />}
			{tool.component === 'PdfMerger' && <PdfMerger client:load />}
			{tool.component === 'PdfSplitter' && <PdfSplitter client:load />}
			{tool.component === 'PdfPageRotator' && <PdfPageRotator client:load />}
			{tool.component === 'ImageFormatConverter' && <ImageFormatConverter client:load />}
			{tool.component === 'ImageCropper' && <ImageCropper client:load />}
			{tool.component === 'ImageUpscaler' && <ImageUpscaler client:load />}
			{tool.component === 'MarkdownEditor' && <MarkdownEditor client:load />}
			{tool.component === 'TextLogoGenerator' && <TextLogoGenerator client:load />}
			{tool.component === 'MonogramLogoGenerator' && <MonogramLogoGenerator client:load />}
			{tool.component === 'LogoStudioApp' && <LogoStudioApp client:only="react" preset={tool.preset} />}
		</div>
		<section class="tool-guide" aria-labelledby="how-to-use">
			<h2 id="how-to-use">How to use {tool.name}</h2>
			<ol>
				{tool.howTo.map((step) => <li>{step}</li>)}
			</ol>
			<div class="tool-faqs">
				{tool.faqs.map((faq) => (
					<article class="tool-faq">
						<h3>{faq.question}</h3>
						<p>{faq.answer}</p>
					</article>
				))}
			</div>
		</section>
		{tool.recommended && <Recommended {...tool.recommended} />}
	</section>
</ToolLayout>
