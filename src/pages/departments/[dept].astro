---
import ToolLayout from '../../components/ToolLayout.astro';
import { departments, getPublishedToolHref, publishedTools } from '../../data/tools';

export function getStaticPaths() {
	return departments.map((department) => ({
		params: { dept: department.slug },
		props: { department },
	}));
}

const { department } = Astro.props;
const departmentTools = publishedTools.filter((tool) => tool.department === department.slug);
---

<ToolLayout title={`${department.name} tools`} description={department.description}>
	<section class="department-page">
		<header class="page-intro">
			<a class="back-link" href="/#tool-library">← All tools</a>
			<p class="eyebrow">BROWSE BY DEPARTMENT</p>
			<h1>{department.name} tools</h1>
			<p>{department.description}</p>
		</header>
		<div class="tool-grid">
			{departmentTools.map((tool, index) => (
				<a class="tool-card" href={getPublishedToolHref(`/${tool.slug}/`)} style={`--card-index: ${index}`}>
					<div class="tool-card-top">
						<span class="tool-icon" aria-hidden="true">{tool.icon}</span>
						<span class="tool-arrow" aria-hidden="true">↗</span>
					</div>
					<div class="tool-card-copy">
						<span class="tool-category">{department.name}</span>
						<h3>{tool.name}</h3>
						<p>{tool.description}</p>
					</div>
					<span class="card-bottom"><span>Open tool</span><span aria-hidden="true">→</span></span>
				</a>
			))}
		</div>
	</section>
</ToolLayout>
