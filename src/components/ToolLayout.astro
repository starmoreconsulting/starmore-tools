---
import { departments } from '../data/tools';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f8f7f2" />
		<title>{title} — Starmore Tools</title>
	</head>
	<body>
		<div class="site-shell">
			<header class="site-header">
				<a class="brand" href="/" aria-label="Starmore Tools home">
					<span class="brand-mark" aria-hidden="true">✳</span>
					<span>starmore<span class="brand-light"> tools</span></span>
				</a>
				<nav class="main-nav" aria-label="Main navigation">
					<a href="/#tool-library">All tools</a>
					<a href="/logo-studio/">Logo Studio</a>
					{departments.filter((department) => department.slug !== 'logo').map((department) => (
						<a href={`/departments/${department.slug}`}>{department.name}</a>
					))}
				</nav>
				<a class="header-note" href="/#tool-library">A little more useful <span aria-hidden="true">↗</span></a>
			</header>
			<main>
				<slot />
			</main>
			<footer class="site-footer">
				<a class="brand footer-brand" href="/">
					<span class="brand-mark" aria-hidden="true">✳</span>
					<span>starmore<span class="brand-light"> tools</span></span>
				</a>
				<p>Good tools make room for good work.</p>
				<span class="footer-year">© {new Date().getFullYear()} Starmore Tools</span>
			</footer>
		</div>
	</body>
</html>

<style is:global>

	:root {
		font-family: 'DM Sans', sans-serif;
		color: #202b25;
		background: #f8f7f2;
		font-synthesis: none;
		text-rendering: optimizeLegibility;
		-webkit-font-smoothing: antialiased;
		--ink: #202b25;
		--muted: #788078;
		--line: #e8e7df;
		--paper: #f8f7f2;
		--green: #37694f;
		--lime: #d7ed79;
		--mono: 'DM Mono', monospace;
	}

	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; }
	body { margin: 0; min-width: 320px; }
	a { color: inherit; text-decoration: none; }
	button, input, textarea, select { font: inherit; }
	.site-shell { width: min(1200px, calc(100% - 64px)); margin: 0 auto; }
	.site-header { height: 82px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
	.brand { display: inline-flex; align-items: center; gap: 9px; font-family: Manrope, sans-serif; font-size: 17px; font-weight: 800; letter-spacing: -0.8px; }
	.brand-mark { display: grid; width: 28px; height: 28px; place-items: center; color: var(--green); font-size: 22px; }
	.brand-light { color: #81867d; font-weight: 500; }
	.main-nav { display: flex; gap: 36px; margin-left: 55px; }
	.main-nav a, .header-note { color: #666f67; font-size: 12px; font-weight: 600; transition: color .2s ease; }
	.main-nav a:hover, .header-note:hover { color: var(--green); }
	.header-note { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: .04em; }
	.header-note span { padding-left: 7px; color: var(--green); }
	.site-footer { min-height: 100px; display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--line); color: var(--muted); font-size: 11px; }
	.footer-brand { color: var(--ink); font-size: 14px; }
	.footer-brand .brand-mark { width: 22px; height: 22px; font-size: 18px; }
	.footer-year { font-family: var(--mono); font-size: 10px; }
	.visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

	.hero { min-height: 465px; position: relative; display: grid; grid-template-columns: 1fr 1fr; align-items: center; overflow: hidden; border-bottom: 1px solid var(--line); }
	.hero-copy { z-index: 1; padding: 45px 0 58px 25px; }
	.eyebrow { margin: 0 0 22px; color: #788078; font-family: var(--mono); font-size: 10px; letter-spacing: .13em; }
	.eyebrow-dot { display: inline-block; width: 7px; height: 7px; margin-right: 8px; border-radius: 50%; background: #9dc46c; vertical-align: 1px; }
	.hero h1 { margin: 0; font-family: Manrope, sans-serif; font-size: clamp(48px, 6vw, 75px); line-height: .99; letter-spacing: -5px; font-weight: 600; }
	.hero h1 span { color: var(--green); }
	.hero-description { max-width: 405px; margin: 23px 0 24px; color: #707870; font-size: 14px; line-height: 1.8; }
	.hero-link { display: inline-flex; align-items: center; gap: 13px; padding: 11px 15px; border: 1px solid #dfe3d5; border-radius: 4px; color: var(--green); font-size: 11px; font-weight: 700; transition: background .2s, transform .2s; }
	.hero-link:hover { background: #eef2e5; transform: translateY(-2px); }
	.hero-link span { font-size: 16px; }
	.hero-art { position: relative; height: 380px; }
	.art-orbit { position: absolute; border: 1px solid #e8e9df; border-radius: 50%; }
	.orbit-one { width: 430px; height: 310px; top: 43px; left: 52px; transform: rotate(-24deg); }
	.orbit-two { width: 350px; height: 390px; top: -1px; left: 98px; transform: rotate(38deg); }
	.art-card { position: absolute; top: 99px; left: 130px; width: 315px; padding: 0 22px 18px; border: 1px solid #e6e5dc; border-radius: 7px; background: #fffefa; box-shadow: 0 24px 60px #38463712; transform: rotate(-5deg); }
	.art-card-top { display: flex; gap: 5px; height: 40px; align-items: center; border-bottom: 1px solid #efeee8; }
	.art-card-top span { width: 6px; height: 6px; border-radius: 50%; background: #d7d9cf; }
	.art-card-top span:first-child { background: #a7c87d; }
	.art-code { padding-top: 13px; color: #818981; font-family: var(--mono); font-size: 11px; }
	.art-code i { color: #738c62; font-style: normal; }
	.art-code b { color: #54745b; font-weight: 500; }
	.art-code em { color: #bb8b52; font-style: normal; }
	.art-code.indent { padding-left: 24px; }
	.cursor { display: inline-block; width: 1px; height: 13px; margin-left: 3px; background: #8ca764; vertical-align: -3px; }
	.art-card-label { padding-top: 25px; color: #a1a59b; font-family: var(--mono); font-size: 8px; letter-spacing: .06em; text-transform: uppercase; }
	.art-star { position: absolute; z-index: 1; color: #a4bb74; }
	.star-one { top: 66px; left: 99px; font-size: 25px; }
	.star-two { top: 277px; right: 51px; color: #d3a66c; font-size: 19px; }
	.art-badge { position: absolute; right: 14px; bottom: 55px; display: grid; width: 83px; height: 83px; place-content: center; border-radius: 50%; background: var(--lime); color: #4a6040; font-family: var(--mono); font-size: 8px; line-height: 1.6; text-align: center; letter-spacing: .08em; transform: rotate(10deg); }
	.hero-footnote { position: absolute; bottom: 24px; left: 25px; color: #9a9e95; font-family: var(--mono); font-size: 9px; letter-spacing: .04em; }
	.hero-footnote span { margin-right: 12px; color: var(--green); }

	.library { padding: 67px 25px 62px; }
	.library-heading { display: flex; align-items: end; justify-content: space-between; }
	.library-heading .eyebrow { margin-bottom: 12px; font-size: 9px; }
	.library-heading h2 { margin: 0; font-family: Manrope, sans-serif; font-size: 29px; font-weight: 600; letter-spacing: -1.2px; }
	.search-wrap { display: flex; width: 258px; height: 40px; align-items: center; gap: 9px; padding: 0 10px; border: 1px solid #e2e2d9; border-radius: 4px; background: #fbfaf6; }
	.search-icon { color: #7e887b; font-size: 23px; line-height: 1; transform: rotate(-20deg); }
	.search-wrap input { width: 100%; border: 0; outline: 0; background: transparent; color: var(--ink); font-size: 11px; }
	.search-wrap input::placeholder { color: #a0a49b; }
	.search-wrap:focus-within { border-color: #9eaf8c; box-shadow: 0 0 0 3px #78936714; }
	.search-wrap kbd { display: grid; width: 19px; height: 20px; place-items: center; border: 1px solid #e9e9e2; border-radius: 3px; color: #9ca196; font-family: var(--mono); font-size: 10px; }
	.department-links { display: flex; gap: 8px; margin: 25px 0 18px; }
	.department-chip { display: inline-flex; height: 28px; align-items: center; gap: 10px; padding: 0 11px; border: 1px solid #e8e8df; border-radius: 3px; color: #747b72; font-size: 10px; }
	.department-chip span { color: #9da196; font-family: var(--mono); font-size: 9px; }
	.department-chip:hover, .department-chip.active { border-color: #d6dfcd; background: #eff2e9; color: #43664a; }
	.tool-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 13px; }
	.tool-card { min-height: 206px; display: flex; flex-direction: column; padding: 17px 18px 14px; border: 1px solid #e8e7df; border-radius: 4px; background: #fbfaf6; transition: border-color .2s, box-shadow .2s, transform .2s; animation: card-in .45s both; animation-delay: calc(var(--card-index, 0) * 55ms); }
	.tool-card:hover { border-color: #c4d2b7; box-shadow: 0 10px 24px #253c2510; transform: translateY(-3px); }
	.tool-card[hidden] { display: none; }
	@keyframes card-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
	.tool-card-top { display: flex; align-items: center; justify-content: space-between; }
	.tool-icon { display: grid; min-width: 39px; height: 36px; place-items: center; padding: 0 7px; border: 1px solid #e6e9dc; border-radius: 4px; background: #f1f3ea; color: #58734d; font-family: var(--mono); font-size: 11px; }
	.tool-arrow { color: #a8aca2; font-size: 14px; transition: color .2s, transform .2s; }
	.tool-card:hover .tool-arrow { color: var(--green); transform: translate(2px, -2px); }
	.tool-card-copy { margin-top: 17px; }
	.tool-category { color: #92988d; font-family: var(--mono); font-size: 8px; letter-spacing: .1em; text-transform: uppercase; }
	.tool-card h3 { margin: 7px 0 5px; font-family: Manrope, sans-serif; font-size: 16px; font-weight: 700; letter-spacing: -.4px; }
	.tool-card p { margin: 0; color: #81877e; font-size: 10px; line-height: 1.65; }
	.card-bottom { display: flex; justify-content: space-between; margin-top: auto; padding-top: 12px; border-top: 1px solid #efeee8; color: #55704d; font-family: var(--mono); font-size: 9px; }
	.card-bottom span:last-child { font-size: 13px; line-height: 9px; }
	.empty-state { padding: 28px; border: 1px dashed #dedfd5; color: var(--muted); font-size: 12px; text-align: center; }
	.library-foot { display: flex; justify-content: space-between; margin-top: 22px; color: #a1a59b; font-family: var(--mono); font-size: 8px; letter-spacing: .1em; }
	.library-foot span:last-child { color: #99ad77; font-size: 16px; }

	.page-intro { padding: 58px 25px 30px; }
	.page-intro .eyebrow { margin-bottom: 12px; }
	.page-intro h1 { margin: 0; font-family: Manrope, sans-serif; font-size: 42px; font-weight: 600; letter-spacing: -2px; }
	.page-intro p:last-child { max-width: 540px; margin: 12px 0 0; color: #788078; font-size: 13px; line-height: 1.7; }
	.department-page { padding-bottom: 70px; }
	.department-page .tool-grid { padding: 0 25px; }
	.back-link { display: inline-block; margin-bottom: 20px; color: #64805a; font-family: var(--mono); font-size: 10px; }
	.tool-page { max-width: 850px; margin: 0 auto; padding: 46px 25px 80px; }
	.tool-page-header { margin-bottom: 27px; }
	.tool-page-header .eyebrow { margin-bottom: 11px; }
	.tool-page-header h1 { margin: 0; font-family: Manrope, sans-serif; font-size: 38px; font-weight: 600; letter-spacing: -1.8px; }
	.tool-page-header p:last-child { margin: 10px 0 0; color: #778078; font-size: 13px; line-height: 1.7; }
	.tool-workspace { padding: 22px; border: 1px solid var(--line); border-radius: 5px; background: #fbfaf6; }
	.tool-workspace label { display: block; margin-bottom: 9px; color: #59645a; font-family: var(--mono); font-size: 9px; letter-spacing: .07em; text-transform: uppercase; }
	.tool-workspace textarea, .tool-workspace pre { width: 100%; min-height: 190px; resize: vertical; padding: 14px; border: 1px solid #e5e5dc; border-radius: 3px; outline: none; background: #fffefa; color: #354139; font-family: var(--mono); font-size: 12px; line-height: 1.7; }
	.tool-workspace textarea:focus { border-color: #a8ba9a; box-shadow: 0 0 0 3px #78936712; }
	.tool-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
	.tool-button { min-height: 35px; padding: 0 14px; border: 1px solid #dce2d4; border-radius: 3px; background: #eef2e8; color: #42644a; cursor: pointer; font-size: 11px; font-weight: 700; transition: background .2s; }
	.tool-button:hover { background: #e2ead8; }
	.tool-button.secondary { border-color: #e6e5dc; background: transparent; color: #6f786e; }
	.tool-message { min-height: 18px; margin: 11px 0 0; color: #69805a; font-size: 11px; }
	.tool-message.error { color: #a04d3e; }
	.stats-row { display: flex; flex-wrap: wrap; gap: 25px; margin: 14px 0 0; color: #7a8379; font-family: var(--mono); font-size: 10px; }
	.stats-row strong { color: #36493a; font-size: 12px; }
	.case-actions { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 12px; }
	.json-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
	.json-output { margin: 0; overflow: auto; }
	.percentage-tabs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 27px; padding-bottom: 15px; border-bottom: 1px solid var(--line); }
	.percentage-tab { padding: 8px 11px; border: 1px solid transparent; border-radius: 3px; background: transparent; color: #737c72; cursor: pointer; font-size: 10px; }
	.percentage-tab:hover, .percentage-tab.active { border-color: #dce2d4; background: #eef2e8; color: #42644a; }
	.percentage-question { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; color: #475449; font-size: 15px; line-height: 2.4; }
	.percentage-question input { width: 110px; height: 39px; padding: 0 10px; border: 1px solid #e5e5dc; border-radius: 3px; outline: none; background: #fffefa; color: var(--ink); font-family: var(--mono); font-size: 13px; }
	.percentage-question input:focus { border-color: #a8ba9a; box-shadow: 0 0 0 3px #78936712; }
	.percentage-result { display: flex; min-height: 78px; align-items: center; gap: 15px; margin-top: 22px; padding: 13px 15px; border: 1px solid #e6e9dc; border-radius: 3px; background: #f3f5ed; }
	.percentage-result-label { color: #899184; font-family: var(--mono); font-size: 9px; letter-spacing: .08em; }
	.percentage-result strong { color: #42644a; font-family: Manrope, sans-serif; font-size: 24px; font-weight: 700; }
	.percentage-error { color: #a04d3e; font-size: 10px; }
	.calc-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 15px; }
	.calc-fields.three-columns { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	.calc-field { min-width: 0; }
	.calc-field input, .calc-field select { width: 100%; min-height: 41px; padding: 0 11px; border: 1px solid #e5e5dc; border-radius: 3px; outline: none; background: #fffefa; color: #354139; font-family: var(--mono); font-size: 12px; }
	.calc-field input:focus, .calc-field select:focus { border-color: #a8ba9a; box-shadow: 0 0 0 3px #78936712; }
	.calc-input-suffix { position: relative; }
	.calc-input-suffix input { padding-right: 47px; }
	.calc-input-suffix span { position: absolute; top: 50%; right: 12px; color: #858d82; font-family: var(--mono); font-size: 10px; transform: translateY(-50%); }
	.calc-result-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-top: 17px; }
	.calc-result-grid.three-columns { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	.calc-result { min-width: 0; min-height: 78px; display: flex; flex-direction: column; justify-content: center; gap: 7px; padding: 12px; border: 1px solid #e6e9dc; border-radius: 3px; background: #f3f5ed; }
	.calc-result.featured { background: #edf2e5; }
	.calc-label { color: #899184; font-family: var(--mono); font-size: 8px; letter-spacing: .08em; }
	.calc-result strong { overflow-wrap: anywhere; color: #42644a; font-family: Manrope, sans-serif; font-size: clamp(16px, 2.8vw, 22px); font-weight: 700; }
	.calc-result small { color: #858d82; font-size: 9px; line-height: 1.4; }
	.unit-result-label { font-size: 13px !important; }
	.duplicate-columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
	.duplicate-columns textarea { min-height: 170px; }
	.duplicate-options { display: flex; flex-wrap: wrap; gap: 10px 18px; margin: 15px 0 0; padding: 11px 13px 13px; border: 1px solid #e6e5dc; border-radius: 3px; }
	.duplicate-options legend { padding: 0 5px; color: #59645a; font-family: var(--mono); font-size: 9px; letter-spacing: .07em; text-transform: uppercase; }
	.duplicate-option { display: inline-flex !important; align-items: center; gap: 7px; margin: 0 !important; color: #687269 !important; font-family: 'DM Sans', sans-serif !important; font-size: 11px !important; letter-spacing: normal !important; text-transform: none !important; cursor: pointer; }
	.duplicate-option input { accent-color: #55744d; }
	.tool-choice-row { display: flex; flex-wrap: wrap; gap: 13px 20px; margin: 15px 0; }
	.tool-choice { display: inline-flex !important; align-items: center; gap: 7px; margin: 0 !important; color: #687269 !important; font-family: 'DM Sans', sans-serif !important; font-size: 11px !important; letter-spacing: normal !important; text-transform: none !important; cursor: pointer; }
	.tool-choice input { accent-color: #55744d; }
	.tool-control { min-width: 0; }
	.tool-control input:not([type='checkbox']):not([type='color']), .tool-control select { width: 100%; min-height: 41px; padding: 0 11px; border: 1px solid #e5e5dc; border-radius: 3px; outline: none; background: #fffefa; color: #354139; font-family: var(--mono); font-size: 12px; }
	.tool-control input[type='range'] { min-height: auto; padding: 0; accent-color: #55744d; }
	.tool-control input[type='color'] { width: 100%; height: 41px; padding: 4px; border: 1px solid #e5e5dc; border-radius: 3px; background: #fffefa; cursor: pointer; }
	.tool-control input:focus, .tool-control select:focus { border-color: #a8ba9a; box-shadow: 0 0 0 3px #78936712; }
	.tool-preview { display: flex; min-height: 180px; align-items: center; justify-content: center; margin-top: 16px; padding: 16px; border: 1px solid #e6e5dc; border-radius: 3px; background: #fffefa; }
	.tool-preview img { display: block; max-width: 100%; max-height: 360px; object-fit: contain; }
	.tool-code-preview { width: min(100%, 360px); height: auto; image-rendering: pixelated; }
	.password-output { width: 100%; min-height: 58px !important; resize: none !important; overflow-wrap: anywhere; font-size: 15px !important; }
	.privacy-note { margin: 13px 0 0; padding: 10px 12px; border: 1px solid #e6e9dc; border-radius: 3px; background: #f3f5ed; color: #566d52; font-size: 11px; line-height: 1.6; }
	.inline-note { color: #788078; font-size: 10px; line-height: 1.6; }
	.image-file-input { display: block; width: 100%; min-height: 41px; padding: 8px; border: 1px solid #e5e5dc; border-radius: 3px; background: #fffefa; color: #687269; font-size: 11px; }
	.timezone-control { position: relative; margin-top: 16px; }
	.timezone-control > input { width: 100%; min-height: 41px; padding: 0 11px; border: 1px solid #e5e5dc; border-radius: 3px; outline: none; background: #fffefa; color: #354139; font-family: var(--mono); font-size: 11px; }
	.timezone-control > input:focus { border-color: #a8ba9a; box-shadow: 0 0 0 3px #78936712; }
	.timezone-control .inline-note { margin: 0 0 8px; }
	.timezone-results { position: absolute; z-index: 2; top: 100%; right: 0; left: 0; max-height: 220px; overflow: auto; margin: 3px 0 0; padding: 4px; border: 1px solid #e5e5dc; border-radius: 3px; background: #fffefa; box-shadow: 0 8px 20px #202b2515; list-style: none; }
	.timezone-zone-button { width: 100%; padding: 8px; border: 0; border-radius: 2px; background: transparent; color: #465448; cursor: pointer; font-family: var(--mono); font-size: 10px; text-align: left; }
	.timezone-zone-button:hover { background: #eef2e8; }
	.timezone-selected { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 12px; }
	.timezone-chip { display: inline-flex; align-items: center; gap: 7px; padding: 5px 8px; border: 1px solid #dfe5d6; border-radius: 3px; background: #f3f5ed; color: #53644f; font-family: var(--mono); font-size: 9px; }
	.timezone-chip button { padding: 0; border: 0; background: transparent; color: #74816d; cursor: pointer; font-size: 15px; line-height: 1; }
	.timezone-output { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; margin-top: 16px; }
	.timezone-output-card { min-width: 0; padding: 12px; border: 1px solid #e6e9dc; border-radius: 3px; background: #f3f5ed; }
	.timezone-output-card > div { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 5px 10px; }
	.timezone-output-card strong { overflow-wrap: anywhere; color: #53644f; font-family: var(--mono); font-size: 10px; }
	.timezone-output-card span { color: #858d82; font-family: var(--mono); font-size: 9px; }
	.timezone-output-card p { margin: 9px 0 0; color: #36493a; font-size: 13px; font-weight: 600; }
	.tool-guide { margin-top: 30px; padding: 24px 22px; border: 1px solid var(--line); border-radius: 5px; background: #fbfaf6; }
