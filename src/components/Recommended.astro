---
import { getPublishedToolHref } from '../data/tools';

interface Props {
	title: string;
	description: string;
	url?: string;
	buttonText: string;
}

const { title, description, url, buttonText } = Astro.props;
const publishedUrl = url ? getPublishedToolHref(url) : undefined;
---

{publishedUrl && (
	<aside class="recommended-card" aria-label="Recommended">
		<div class="recommended-copy">
			<p class="recommended-label">Recommended</p>
			<h2>{title}</h2>
			<p>{description}</p>
			<small>We may earn a commission if you sign up, at no cost to you.</small>
		</div>
		<a class="recommended-button" href={publishedUrl} target="_blank" rel="sponsored noopener">{buttonText}<span aria-hidden="true">↗</span></a>
	</aside>
)}

<style>
	.recommended-card { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 18px; padding: 18px 20px; border: 1px solid #dfe5d6; border-radius: 5px; background: #f3f5ed; }
	.recommended-copy { min-width: 0; }
	.recommended-label { margin: 0 0 6px; color: #638057; font-family: var(--mono, monospace); font-size: 9px; letter-spacing: .1em; text-transform: uppercase; }
	h2 { margin: 0; color: #354139; font-family: Manrope, sans-serif; font-size: 16px; font-weight: 700; }
	.recommended-copy > p:not(.recommended-label) { margin: 6px 0 8px; color: #69736a; font-size: 11px; line-height: 1.6; }
	small { color: #858d82; font-size: 9px; line-height: 1.5; }
	.recommended-button { display: inline-flex; min-height: 36px; flex: 0 0 auto; align-items: center; gap: 11px; padding: 0 13px; border: 1px solid #dce2d4; border-radius: 3px; background: #fffefa; color: #42644a; font-size: 10px; font-weight: 700; }
	.recommended-button:hover { background: #e8edde; }
	@media (max-width: 520px) {
		.recommended-card { align-items: flex-start; flex-direction: column; padding: 16px; }
	}
</style>
