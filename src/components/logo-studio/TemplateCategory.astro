---
import ToolLayout from '../ToolLayout.astro';
import TemplatePreviewGrid from '../../engines/logo-studio/templates/TemplatePreviewGrid';
import { getPublishedToolHref } from '../../data/tools';

const { category } = Astro.props;
const templatesHref = getPublishedToolHref('/logo-studio/templates/');
---

<ToolLayout
	title={`${category.industry} Logo Templates`}
	description={category.metaDescription}
	robots={!category.indexable ? 'noindex, follow' : undefined}
>
	<section class="tool-page template-library-page">
		{templatesHref && <a class="back-link" href={templatesHref}>← All industries</a>}
		<header class="tool-page-header">
			<p class="eyebrow">{category.industry.toUpperCase()} LOGO IDEAS</p>
			<h1>{category.industry} logo templates</h1>
			<p>{category.description} The examples below use “{category.sampleName}” as a sample name, so you can explore before starting your own design.</p>
		</header>
		<TemplatePreviewGrid client:load category={category} />
	</section>
</ToolLayout>

<style>
	.template-library-page {
		max-width: 76rem;
	}
</style>
