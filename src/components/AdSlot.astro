---
const adsenseReady = import.meta.env.PROD && import.meta.env.PUBLIC_ADSENSE_READY === 'true';
const clientId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID ?? '';
const slotId = import.meta.env.PUBLIC_ADSENSE_SLOT_ID ?? '';

if (adsenseReady && (!/^ca-pub-\d+$/.test(clientId) || !/^\d+$/.test(slotId))) {
	throw new Error('AdSense is enabled but PUBLIC_ADSENSE_CLIENT_ID or PUBLIC_ADSENSE_SLOT_ID is missing or invalid.');
}
---

{adsenseReady && (
	<aside class="ad-slot" aria-label="Advertisement">
		<p>Advertisement</p>
		<ins
			class="adsbygoogle"
			style="display:block"
			data-ad-client={clientId}
			data-ad-slot={slotId}
			data-ad-format="auto"
			data-full-width-responsive="true"
		></ins>
	</aside>
)}

{adsenseReady && (
	<script>
		type AdsWindow = Window & { adsbygoogle?: unknown[] };
		const adsWindow = window as AdsWindow;
		adsWindow.adsbygoogle ??= [];

		for (const element of document.querySelectorAll<HTMLElement>('.adsbygoogle')) {
			if (element.dataset.starmoreRequested === 'true') continue;
			adsWindow.adsbygoogle.push({});
			element.dataset.starmoreRequested = 'true';
		}
	</script>
)}

<style>
	.ad-slot {
		min-height: 280px;
		margin: 28px auto;
		padding: 12px;
		border: 1px solid var(--line);
		border-radius: 8px;
		text-align: center;
	}

	.ad-slot p {
		margin: 0 0 8px;
		color: var(--muted);
		font-family: var(--mono);
		font-size: 10px;
		letter-spacing: .08em;
		text-transform: uppercase;
	}
</style>
